<Window x:Class="PixivRanker.BlacklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 黑名单管理" Width="640" Height="520"
        MinWidth="560" MinHeight="430"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="黑名单管理" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="黑名单中的作者会在所有排行榜下载中自动跳过。"
                       Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Pixiv 作者 ID" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="UserIdTextBox" VerticalContentAlignment="Center"
                             KeyDown="UserIdTextBox_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="作者名或备注（可选）" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="AuthorNameTextBox" VerticalContentAlignment="Center"
                             KeyDown="UserIdTextBox_KeyDown" />
                </StackPanel>
                <Button Grid.Column="4" Content="添加" VerticalAlignment="Bottom"
                        Style="{StaticResource PrimaryButtonStyle}" Click="AddButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <ListView x:Name="BlacklistListView" ItemsSource="{Binding Entries}"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource TextBrush}" SelectionMode="Extended">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="作者 ID" Width="180" DisplayMemberBinding="{Binding UserId}" />
                        <GridViewColumn Header="作者名 / 备注" Width="330" DisplayMemberBinding="{Binding AuthorName}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountTextBlock" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <Button Grid.Column="1" Content="删除选中" Style="{StaticResource SecondaryButtonStyle}"
                    Click="RemoveButton_Click" />
            <Button Grid.Column="3" Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click" />
            <Button Grid.Column="5" Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>
