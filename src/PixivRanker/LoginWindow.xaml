<Window x:Class="PixivRanker.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录 Pixiv" Width="980" Height="760"
        MinWidth="760" MinHeight="560"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="18,14"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="在 Pixiv 官方页面登录" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="AddressTextBlock" Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="正在打开 pixiv.net…" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="ReloadButton" Content="重新加载"
                        Style="{StaticResource SecondaryButtonStyle}" Click="ReloadButton_Click" />
            </Grid>
        </Border>

        <wv2:WebView2 Grid.Row="1" x:Name="LoginWebView" />

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" Padding="18,14"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LoginHintTextBlock" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="完成登录后点击右侧按钮；软件不会读取或保存你的密码。" />
                <Button Grid.Column="1" x:Name="CompleteLoginButton" Content="我已完成登录"
                        Style="{StaticResource PrimaryButtonStyle}" Click="CompleteLoginButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
