<Window x:Class="PixivRanker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pixiv 排行榜下载器" Width="1180" Height="780"
        MinWidth="940" MinHeight="650"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Pixiv 排行榜下载器" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="第一版 · 排行榜原图下载" Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeButton" Content="浅色主题" Margin="0,0,14,0"
                        ToolTip="切换到浅色主题" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ThemeButton_Click" />
                <Ellipse x:Name="LoginStatusDot" Width="8" Height="8"
                         Fill="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="LoginStatusTextBlock" Text="未登录" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,14,0" />
                <Button Content="登录 Pixiv" Style="{StaticResource SecondaryButtonStyle}"
                        Click="LoginButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="9" Padding="20,0">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="AllContentButton" Content="综合" Tag="All" IsChecked="True"
                              Style="{StaticResource NavToggleStyle}" Click="ContentButton_Click" />
                <ToggleButton x:Name="IllustrationContentButton" Content="插画" Tag="Illustration"
                              Style="{StaticResource NavToggleStyle}" Click="ContentButton_Click" />
                <ToggleButton x:Name="UgoiraContentButton" Content="动图" Tag="Ugoira"
                              Style="{StaticResource NavToggleStyle}" Click="ContentButton_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="4,18,4,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RankingTitleTextBlock" Text="综合今日排行榜"
                           FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" x:Name="AgeComboBox" Width="112" SelectedIndex="0"
                          SelectionChanged="AgeComboBox_SelectionChanged">
                    <ComboBoxItem Content="全年龄" Tag="AllAges" />
                    <ComboBoxItem Content="R-18" Tag="R18" />
                </ComboBox>
            </Grid>
            <WrapPanel Grid.Row="1" x:Name="ModeButtonsPanel" Margin="0,12,0,0" />
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" CornerRadius="9"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="下载名次" FontWeight="SemiBold" />
                    <TextBlock x:Name="RankMaxTextBlock" Text="1–100"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="RankRangeTextBox" Text="1-20"
                         VerticalContentAlignment="Center" TextChanged="RankRangeTextBox_TextChanged" />

                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="保存目录" FontWeight="SemiBold" />
                    <TextBlock x:Name="RangeHintTextBlock" Text="将下载第 1–20 名"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
                <TextBox Grid.Column="4" x:Name="DownloadPathTextBox" Margin="12,0,8,0"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="5" Content="选择" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ChooseFolderButton_Click" />
                <Button Grid.Column="7" x:Name="RefreshButton" Content="获取榜单"
                        Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" />
                <Button Grid.Column="9" x:Name="DownloadButton" Content="开始下载" IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}" Click="DownloadButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" CornerRadius="9"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Background="{DynamicResource HeaderBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="名次" Margin="16,10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="作品" Margin="12,10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="2" Text="作者" Margin="12,10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="3" Text="类型" Margin="12,10" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="4" Text="状态" Margin="12,10" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>

                <ListView Grid.Row="1" x:Name="RankingListView" ItemsSource="{Binding RankingItems}"
                          Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Rank}" Margin="20,0,8,0" VerticalAlignment="Center"
                                           FontWeight="Bold" />
                                <StackPanel Grid.Column="1" Margin="12,7" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding UserName}" Margin="12,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding WorkType}" Margin="12,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Column="4" Text="{Binding Status}" Margin="12,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Status}"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,13,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock" Text="请选择排行榜并获取榜单。"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100"
                         Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center" Margin="14,0" />
            <Button Grid.Column="2" x:Name="CancelButton" Content="取消" Visibility="Collapsed"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" />
        </Grid>

        <wv2:WebView2 Grid.Row="0" x:Name="SessionBootstrapWebView" Width="1" Height="1"
                      Visibility="Hidden" IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</Window>
